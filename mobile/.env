# EXPO_PUBLIC_* variables are embedded in the client bundle — never put
# secrets here, only the deployed API's public base URL.
EXPO_PUBLIC_API_BASE_URL=https://intahe-api-staging.onrender.com

# Stripe's publishable key is safe to embed client-side (it can only create
# PaymentMethods/tokens, never charge anything) — pair it with the *test*
# secret key already configured on intahe-api-staging (Dashboard > Developers
# > API keys, test mode, starts with pk_test_).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
