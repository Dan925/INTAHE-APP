{
  "expo": {
    "name": "Intahé",
    "slug": "intahe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.intahe.app"
    },
    "android": {
      "package": "com.intahe.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Intahé utilise ta position pour te montrer les événements à proximité."
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "locationWhenInUsePermission": "Intahé utilise ta position pour te montrer les événements à proximité et pour te connecter à un lecteur de carte Bluetooth à proximité.",
          "bluetoothPeripheralPermission": "Intahé utilise le Bluetooth pour se connecter à un lecteur de carte.",
          "bluetoothAlwaysUsagePermission": "Intahé utilise le Bluetooth pour se connecter à un lecteur de carte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
