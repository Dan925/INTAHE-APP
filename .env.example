NODE_ENV=development
PORT=3000

# Postgres connection string used both by the app and by node-pg-migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intahe_dev

# JWT signing secret for access tokens
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=7d

# Password reset tokens are single-use and expire after this many minutes
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# How long a pending order holds its ticket-type reservation before it's
# released back to inventory (abandoned checkout, declined card, etc.)
ORDER_RESERVATION_TTL_MINUTES=20

# Rate limiting on /v1/auth/login, /v1/auth/signup, and the password-reset
# request endpoint. Each route is limited both by client IP and by the
# email in the request body, sharing this window/max.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Rate limiting on GET /v1/events/:eventId/orders/:orderId/tickets, by
# client IP and by the orderId being looked up.
TICKET_LOOKUP_RATE_LIMIT_WINDOW_MS=900000
TICKET_LOOKUP_RATE_LIMIT_MAX=20

# Rate limiting on GET /v1/events/:eventId/orders/:orderId/confirmation, by
# client IP and by orderId. Higher than the other limits above: this route
# is meant to be polled repeatedly right after payment while waiting for
# the webhook to issue tickets.
CONFIRMATION_RATE_LIMIT_WINDOW_MS=300000
CONFIRMATION_RATE_LIMIT_MAX=100
# How long that route keeps handing out a fresh access token after tickets
# are issued, before falling back to "check your email" (which never
# expires).
CONFIRMATION_TOKEN_WINDOW_MINUTES=10

# Anti-hoarding bounds on a single checkout request (POST
# /v1/events/:eventId/orders) — without these, nothing capped how many
# tickets one order could reserve for the whole reservation window.
# 10/line matches a typical table (Intahe's target segment sells tables of
# 8-10); 50/order accommodates a sponsor buying several tables in one
# transaction. Actual hoarding protection is reservation expiry + the
# checkout rate limit below — these two just bound a single request.
MAX_QUANTITY_PER_LINE_ITEM=10
MAX_QUANTITY_PER_ORDER=50
# Rate limiting on the same route, by client IP and by buyer_email.
CHECKOUT_RATE_LIMIT_WINDOW_MS=900000
CHECKOUT_RATE_LIMIT_MAX=20

# Stripe Connect (destination charges). Use test-mode keys locally; the app
# boots fine with placeholders, but checkout/webhooks will fail without real
# ones since those calls hit the actual Stripe API.
STRIPE_SECRET_KEY=sk_test_replace_me
# Comma-separated list. Stripe's Event Destinations can issue a distinct
# signing secret per destination even when they share the same URL (e.g. one
# scoped to "your account" for payment_intent.succeeded, another scoped to
# "connected accounts" for account.updated) — list every whsec_ value here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Safe to expose client-side — used by the public web checkout pages'
# Stripe.js Payment Element. Must match the same Stripe account as
# STRIPE_SECRET_KEY above.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Where Stripe redirects the organizer during Connect onboarding. Replace
# with real frontend routes once one exists.
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/stripe/connect/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/stripe/connect/return

# Comma-separated OAuth client IDs (iOS/Android/web) — every `aud` value
# POST /v1/auth/google should accept as valid.
GOOGLE_OAUTH_CLIENT_IDS=replace-me.apps.googleusercontent.com

# Comma-separated `aud` values POST /v1/auth/apple should accept — normally
# just the app's bundle identifier (native Sign in with Apple).
APPLE_CLIENT_IDS=com.intahe.app

# Transactional email (password reset, order confirmation). With the
# placeholder key, emails are logged instead of sent — the app boots fine,
# nothing actually gets delivered until this is a real Resend API key.
RESEND_API_KEY=re_replace_me
EMAIL_FROM_ADDRESS=no-reply@intahe.app
EMAIL_FROM_NAME=Intahe

# Frontend route the password reset email's link points to. Replace with a
# real frontend route once one exists.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
